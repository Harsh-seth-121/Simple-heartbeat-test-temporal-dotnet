    {
      "type": "stat",
      "title": "Target rate",
      "description": "LOADGEN_TARGET_RATE_PER_SEC, echoed as a gauge so it can be drawn against reality.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(loadgen_target_rate)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
