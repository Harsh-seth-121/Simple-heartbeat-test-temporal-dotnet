# Copy to .env and edit. Compose reads .env automatically; every value below is also the built-in
# default, so an empty .env works.

# ---- Target: local stack or Temporal Cloud -------------------------------------------------
# local  -> the containers in docker-compose.yml
# cloud  -> set TEMPORAL_ADDRESS/TEMPORAL_NAMESPACE plus either TEMPORAL_API_KEY or the mTLS pair
TEMPORAL_TARGET=local
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# Cloud, API key auth:
# TEMPORAL_ADDRESS=your-ns.a1b2c.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=your-ns.a1b2c
# TEMPORAL_API_KEY=your-api-key

# Cloud, mTLS auth (mount the files into the containers first):
# TEMPORAL_TLS_CLIENT_CERT_PATH=/secrets/client.pem
# TEMPORAL_TLS_CLIENT_KEY_PATH=/secrets/client.key

# Blank credentials are treated as absent, so the local stack stays on plaintext even though the
# variables above are always declared. Set this only for a server that wants TLS but no client
# credentials.
# TEMPORAL_TLS=true

# ---- Job shape -----------------------------------------------------------------------------
TASK_QUEUE=long-activity-heartbeat
JOB_ITEM_COUNT=200
JOB_PER_ITEM_MILLIS=250
# Must stay well under the Activity's start-to-close budget. Heartbeats flush at ~80% of this, so
# lowering it tightens both failure detection and the resume overlap.
HEARTBEAT_TIMEOUT_SECONDS=10

# ---- Chaos ---------------------------------------------------------------------------------
# Per-item probability the Activity throws. 0 disables. This is what makes resume-from-checkpoint
# visible without manually killing anything.
CHAOS_FAILURE_RATE=0.02

# ---- Worker --------------------------------------------------------------------------------
WORKER_MAX_CONCURRENT_ACTIVITIES=100

# ---- Load generator ------------------------------------------------------------------------
# A job takes about JOB_ITEM_COUNT * JOB_PER_ITEM_MILLIS, longer once chaos forces retries,
# so steady-state concurrency is roughly rate * job duration. At the defaults that is well
# under LOADGEN_MAX_IN_FLIGHT, which keeps rate debt flat. Raise the rate to watch it climb.
LOADGEN_TARGET_RATE_PER_SEC=0.5
LOADGEN_MAX_IN_FLIGHT=50
# 0 runs until the container is stopped.
LOADGEN_DURATION_SECONDS=0
